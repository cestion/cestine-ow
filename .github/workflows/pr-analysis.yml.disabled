name: PR Analysis

on:
  pull_request:
    types: [opened, synchronize, reopened]

# Concurrency: cancel superseded runs on the same PR
concurrency:
  group: pr-analysis-${{ github.event.pull_request.number }}
  cancel-in-progress: true

# =============================================================================
# Config knobs - flip these in repo/org Variables (Settings → Variables) to
# turn scans on/off without editing the workflow file.
#
#   ENABLE_SONAR       : "true"  → run SonarQube job          (default: false)
#   ENABLE_PR_AGENT    : "true"  → run PR-Agent job           (default: true)
#   ENABLE_IMPACT      : "true"  → run impact-analysis job    (default: true)
#   ENABLE_IMPACT_AI   : "true"  → run MiniMax impact-risk    (default: true)
#   ENABLE_BUNDLE_DIFF : "true"  → run bundle-size diff job   (default: true)
#   ENABLE_TSC_DIFF    : "true"  → run tsc error diff job     (default: true)
#
#   PR_AGENT_MODEL     : LLM model id used by PR-Agent
#                        e.g. "anthropic/claude-opus-4-8"
#                             "openai/gpt-4o"
#                             "gemini/gemini-2.5-pro"
#                             "openai/MiniMax-M3"   ← custom via LITELLM_BASE_URL
#                        (default: "anthropic/claude-opus-4-8")
#
#   MINIMAX_MODEL      : model id for the impact-ai job
#                        (default: "MiniMax-M3")
#   MINIMAX_BASE_URL   : API base for MiniMax
#                        (default: "https://api.minimaxi.com/v1")
# =============================================================================

jobs:
  # ---------------------------------------------------------------------------
  # 1. SonarQube static analysis (disabled by default)
  # ---------------------------------------------------------------------------
  sonar:
    name: SonarQube
    if: vars.ENABLE_SONAR == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: SonarQube Scan
        uses: SonarSource/sonarqube-scan-action@v4
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
        with:
          args: >
            -Dsonar.projectKey=${{ vars.SONAR_PROJECT_KEY || 'web-onestory' }}
            -Dsonar.pullrequest.key=${{ github.event.pull_request.number }}
            -Dsonar.pullrequest.branch=${{ github.head_ref }}
            -Dsonar.pullrequest.base=${{ github.base_ref }}

  # ---------------------------------------------------------------------------
  # 2. AI code review via PR-Agent (Qodo)
  # ---------------------------------------------------------------------------
  pr-agent:
    name: PR-Agent (AI Review)
    if: vars.ENABLE_PR_AGENT != 'false'
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: read
      issues: write
    steps:
      - name: PR-Agent action
        uses: qodo-ai/pr-agent@main
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

          # LLM backend selection — pick ONE of the following per your model:
          OPENAI_KEY:        ${{ secrets.OPENAI_KEY }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}

          # For self-hosted / custom / non-standard models (e.g. minmax-m3) route
          # through LiteLLM — set BOTH secrets and use "openai/<model>" as
          # config.model, since LiteLLM speaks OpenAI protocol at the edge.
          OPENAI_API_BASE: ${{ secrets.LITELLM_BASE_URL }}

          # PR-Agent config overrides (any config.* key can be set as env var)
          CONFIG__MODEL: ${{ vars.PR_AGENT_MODEL || 'anthropic/claude-opus-4-8' }}
          CONFIG__FALLBACK_MODELS: '["anthropic/claude-haiku-4-5-20251001"]'
          CONFIG__PUBLISH_OUTPUT: 'true'
          CONFIG__VERBOSITY_LEVEL: '1'

          # Auto-run these on every PR
          GITHUB_ACTION_CONFIG__AUTO_DESCRIBE: 'true'
          GITHUB_ACTION_CONFIG__AUTO_REVIEW: 'true'
          GITHUB_ACTION_CONFIG__AUTO_IMPROVE: 'false'

          # Focused review prompt (impact-oriented, not style)
          PR_REVIEWER__EXTRA_INSTRUCTIONS: |
            重点关注:
            1. 影响范围 — 改动的模块被谁引用,是否有跨页面/跨路由的副作用
            2. 回归风险 — 是否可能破坏其他功能,尤其是共享 hooks / stores / providers
            3. 安全 — 敏感数据处理、鉴权、XSS、SQL/命令注入
            4. 性能 — 不必要的重渲染、bundle 体积、hot path 上的同步操作
            忽略纯样式和格式化建议(Biome 已经在处理)。

  # ---------------------------------------------------------------------------
  # 3. Impact analysis — changed files → routes → reverse deps
  # ---------------------------------------------------------------------------
  impact:
    name: Impact Analysis
    if: vars.ENABLE_IMPACT != 'false'
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - run: pnpm install --frozen-lockfile

      - name: Install madge
        run: pnpm add -w -D madge

      - name: Run impact analysis
        id: impact
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: pnpm exec tsx scripts/pr-impact-analysis.ts > impact-report.md

      - name: Comment on PR
        uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: pr-impact
          path: impact-report.md

      - name: Upload impact report artifact
        uses: actions/upload-artifact@v4
        with:
          name: impact-report
          path: impact-report.md
          retention-days: 7

  # ---------------------------------------------------------------------------
  # 3.5. AI impact-risk assessment via MiniMax-M3
  #      Consumes the impact-report artifact + the raw diff and asks MiniMax
  #      to produce a risk assessment (blast radius, regression risk, missing
  #      test coverage, concrete files to double-check).
  # ---------------------------------------------------------------------------
  impact-ai:
    name: Impact Risk (MiniMax)
    if: vars.ENABLE_IMPACT_AI != 'false'
    needs: impact
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Download impact report
        uses: actions/download-artifact@v4
        with:
          name: impact-report

      - name: Build diff summary
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          # Numstat gives us added/removed lines per file — cheap signal, avoids blowing the LLM context
          git diff --numstat "$BASE_SHA" "$HEAD_SHA" > diff-numstat.txt

          # Truncated unified diff (cap per-file + total to keep prompt under model limits)
          git diff --unified=3 --stat "$BASE_SHA" "$HEAD_SHA" > diff-stat.txt
          git diff --unified=3 "$BASE_SHA" "$HEAD_SHA" \
            -- 'src/**' ':(exclude)src/api/__generated__/**' ':(exclude)src/solana/**' ':(exclude)src/routeTree.gen.ts' \
            | head -c 120000 > diff-truncated.patch

      - name: Call MiniMax-M3
        env:
          MINIMAX_KEY_BLOB: ${{ secrets.MINIMAX_KEY_BLOB }}
          MINIMAX_MODEL:    ${{ vars.MINIMAX_MODEL || 'MiniMax-M3' }}
          MINIMAX_BASE:     ${{ vars.MINIMAX_BASE_URL || 'https://api.minimaxi.com/anthropic' }}
          PR_TITLE:         ${{ github.event.pull_request.title }}
          PR_BODY:          ${{ github.event.pull_request.body }}
        run: |
          if [ -z "$MINIMAX_KEY_BLOB" ]; then
            echo "## 🤖 Impact Risk (MiniMax-M3)" > ai-report.md
            echo "" >> ai-report.md
            echo "_MINIMAX_KEY_BLOB secret not set — skipping AI assessment._" >> ai-report.md
            exit 0
          fi

          MINIMAX_API_KEY=$(./scripts/lib/keyring.sh decode "$MINIMAX_KEY_BLOB")
          if [ -z "$MINIMAX_API_KEY" ]; then
            echo "## 🤖 Impact Risk (MiniMax-M3)" > ai-report.md
            echo "" >> ai-report.md
            echo "_Failed to decode MINIMAX_KEY_BLOB — check the encoded value._" >> ai-report.md
            exit 0
          fi

          IMPACT=$(cat impact-report.md)
          STAT=$(cat diff-stat.txt)
          DIFF=$(cat diff-truncated.patch)

          cat > /tmp/system-prompt.txt <<'PROMPT_EOF'
          你是一名资深工程师 + 产品经理,正在评审一个 pull request。你会收到:(1) 静态影响分析报告,(2) diff stat,(3) 截断的 unified diff,(4) 项目业务模块清单。用中文输出精简的 Markdown 风险评估,包含以下 5 段:

          **💼 业务影响** — 从终端用户视角说明:改动波及了哪些业务模块(参考业务清单,如创作、演员、剧本、观看、收益、邀请、UGC、社交、内购、挖矿等)?对应的用户流程可能出现什么变化(如无法进入某个页面、某个操作行为不同、数据展示错误、支付/发放异常)?按业务优先级排序,最多 5 条,每条格式为 `- **[模块名]** — 具体影响`。如果只改基础设施/工具代码没有直接业务影响,明确说 "无直接业务影响"。

          **🔥 技术影响范围** — 波及的技术表面(路由、共享模块、hooks、stores、providers 等)。

          **⚠️ 回归风险** — 具体可能坏的场景,按严重度排序,最多 5 条。

          **🧪 测试盲区** — 未覆盖的路径,引用具体文件。

          **✅ Reviewer checklist** — 合并前必须验证的 3-6 项。

          要求:引用具体文件路径和函数名;若 diff 看起来安全,直言无风险;不要重复静态报告的内容,要在其上增加信号。

          # 业务模块清单(供业务影响判断参考)
          - **创作(create)** — src/features/create, src/routes/create.tsx, create-short-video
          - **创作管理(creation-management)** — src/features/creation-management
          - **演员(actor)** — src/features/actor, src/routes/actor
          - **旁白/剧本(narrator)** — src/features/narrator
          - **剧集(drama-flow)** — src/features/drama-flow, src/routes/dramas.tsx
          - **观看(play)** — src/features/play, src/routes/play
          - **首页(home / dashboard)** — src/features/home, src/features/dashboard
          - **收益(income)** — src/features/income, src/routes/income
          - **邀请(invite)** — src/features/invite, src/routes/invite
          - **UGC** — src/features/ugc
          - **游戏/1011** — src/features/game, src/features/1011
          - **挖矿(mining)** — src/features/mining
          - **通知(notification)** — src/features/notification
          - **个人资料(profile)** — src/features/profile, src/routes/profile
          - **社交(social)** — src/features/social, src/routes/social-bind.tsx
          - **搜索(search)** — src/features/search, src/routes/search.tsx
          - **勋章/成就(badge)** — src/features/badge
          - **法务(legal / privacy / terms / whitepaper)** — src/features/legal, 相关路由
          - **API 层** — src/api(所有业务接口)
          - **Solana 链上交互** — src/solana(钱包、代币、链上操作)
          - **鉴权/Privy** — @privy-io/react-auth 相关,src/providers
          PROMPT_EOF
          SYSTEM=$(sed 's/^          //' /tmp/system-prompt.txt)

          USER=$(jq -n \
            --arg title "$PR_TITLE" \
            --arg body  "$PR_BODY" \
            --arg impact "$IMPACT" \
            --arg stat   "$STAT" \
            --arg diff   "$DIFF" \
            '"# PR Title\n\($title)\n\n# PR Description\n\($body)\n\n# Impact Report (from static analysis)\n\($impact)\n\n# Diff Stat\n```\n\($stat)\n```\n\n# Truncated Diff\n```diff\n\($diff)\n```"')

          PAYLOAD=$(jq -n \
            --arg model "$MINIMAX_MODEL" \
            --arg system "$SYSTEM" \
            --argjson user "$USER" \
            '{
              model: $model,
              system: $system,
              max_tokens: 2500,
              messages: [ { role: "user", content: $user } ]
            }')

          RESPONSE=$(curl -sS --fail-with-body \
            -X POST "$MINIMAX_BASE/v1/messages" \
            -H "x-api-key: $MINIMAX_API_KEY" \
            -H "anthropic-version: 2023-06-01" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD") || {
              echo "## 🤖 Impact Risk (MiniMax-M3)" > ai-report.md
              echo "" >> ai-report.md
              echo "_MiniMax API call failed:_" >> ai-report.md
              echo '```' >> ai-report.md
              echo "$RESPONSE" | sed "s|$MINIMAX_API_KEY|***|g" >> ai-report.md
              echo '```' >> ai-report.md
              exit 0
            }

          CONTENT=$(echo "$RESPONSE" | jq -r '(.content // []) | map(select(.type=="text") | .text) | join("\n")')
          if [ -z "$CONTENT" ]; then
            CONTENT="_无法解析 MiniMax 响应_"
          fi

          {
            echo "## 🤖 Impact Risk (MiniMax-M3)"
            echo ""
            echo "$CONTENT"
            echo ""
            echo "<sub>Model: \`$MINIMAX_MODEL\` · Prompt cap: 120KB · Truncation may hide signal in very large PRs.</sub>"
          } > ai-report.md

      - uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: pr-impact-ai
          path: ai-report.md

  # ---------------------------------------------------------------------------
  # 4. Bundle-size diff — build base + head, compare .output size and chunks
  # ---------------------------------------------------------------------------
  bundle-diff:
    name: Bundle Size Diff
    if: vars.ENABLE_BUNDLE_DIFF != 'false'
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Build HEAD
        run: |
          pnpm install --frozen-lockfile
          pnpm run build:dev || true
          if [ -d .output ]; then
            du -sb .output | awk '{print $1}' > /tmp/head-size.txt
            find .output -type f -name "*.js" -exec du -b {} \; | sort -rn | head -20 > /tmp/head-chunks.txt
          else
            echo "0" > /tmp/head-size.txt
            echo "" > /tmp/head-chunks.txt
          fi
          rm -rf .output dist

      - name: Build BASE
        run: |
          git checkout ${{ github.event.pull_request.base.sha }} -- .
          pnpm install --frozen-lockfile
          pnpm run build:dev || true
          if [ -d .output ]; then
            du -sb .output | awk '{print $1}' > /tmp/base-size.txt
            find .output -type f -name "*.js" -exec du -b {} \; | sort -rn | head -20 > /tmp/base-chunks.txt
          else
            echo "0" > /tmp/base-size.txt
            echo "" > /tmp/base-chunks.txt
          fi

      - name: Format diff
        id: fmt
        run: |
          BASE=$(cat /tmp/base-size.txt)
          HEAD=$(cat /tmp/head-size.txt)
          DELTA=$((HEAD - BASE))
          BASE_KB=$(awk -v b="$BASE" 'BEGIN{printf "%.1f", b/1024}')
          HEAD_KB=$(awk -v h="$HEAD" 'BEGIN{printf "%.1f", h/1024}')
          DELTA_KB=$(awk -v d="$DELTA" 'BEGIN{printf "%+.1f", d/1024}')

          {
            echo "## 📦 Bundle Size Diff"
            echo ""
            echo "| | Size |"
            echo "|---|---|"
            echo "| Base (\`${{ github.base_ref }}\`) | ${BASE_KB} KB |"
            echo "| Head (\`${{ github.head_ref }}\`) | ${HEAD_KB} KB |"
            echo "| **Δ** | **${DELTA_KB} KB** |"
            echo ""
            echo "<details><summary>Top 20 chunks (HEAD)</summary>"
            echo ""
            echo '```'
            cat /tmp/head-chunks.txt
            echo '```'
            echo "</details>"
          } > bundle-report.md

      - uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: pr-bundle
          path: bundle-report.md

  # ---------------------------------------------------------------------------
  # 5. tsc error diff — new type errors introduced by this PR
  # ---------------------------------------------------------------------------
  tsc-diff:
    name: TypeScript Error Diff
    if: vars.ENABLE_TSC_DIFF != 'false'
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - run: pnpm install --frozen-lockfile

      - name: tsc on HEAD
        run: |
          pnpm exec tsc --noEmit --pretty false 2>&1 \
            | grep -vE "src/api/__generated__/|src/solana/" \
            | grep "error TS" | sort -u > /tmp/head-errors.txt || true

      - name: tsc on BASE
        run: |
          git checkout ${{ github.event.pull_request.base.sha }} -- .
          pnpm install --frozen-lockfile
          pnpm exec tsc --noEmit --pretty false 2>&1 \
            | grep -vE "src/api/__generated__/|src/solana/" \
            | grep "error TS" | sort -u > /tmp/base-errors.txt || true

      - name: Diff
        run: |
          NEW=$(comm -23 /tmp/head-errors.txt /tmp/base-errors.txt)
          FIXED=$(comm -13 /tmp/head-errors.txt /tmp/base-errors.txt)
          NEW_COUNT=$(echo "$NEW" | grep -c "error TS" || true)
          FIXED_COUNT=$(echo "$FIXED" | grep -c "error TS" || true)

          {
            echo "## 🔍 TypeScript Error Diff"
            echo ""
            echo "- ✅ Fixed: **${FIXED_COUNT}**"
            echo "- ❌ New:   **${NEW_COUNT}**"
            echo ""
            if [ "$NEW_COUNT" -gt 0 ]; then
              echo "<details open><summary>New errors</summary>"
              echo ""
              echo '```'
              echo "$NEW"
              echo '```'
              echo "</details>"
            fi
          } > tsc-report.md

      - uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: pr-tsc
          path: tsc-report.md

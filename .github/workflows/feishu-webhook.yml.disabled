name: Feishu Push Notify

on:
  push:
    branches: ["**"]

jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - name: Send Message to Feishu
        env:
          FEISHU_WEBHOOK_URL: ${{ secrets.FEISHU_WEBHOOK_URL }}
          REPO: ${{ github.repository }}
          ACTOR: ${{ github.actor }}
          BRANCH: ${{ github.ref_name }}
          COMMIT_MSG: ${{ github.event.head_commit.message }}
          COMMIT_ID: ${{ github.event.head_commit.id }}
          COMMIT_URL: ${{ github.event.head_commit.url }}
          TIMESTAMP: ${{ github.event.head_commit.timestamp }}
          COMPARE: ${{ github.event.compare }}
        run: |
          SHORT_SHA="${COMMIT_ID:0:7}"
          PAYLOAD=$(jq -n \
            --arg repo    "$REPO" \
            --arg actor   "$ACTOR" \
            --arg branch  "$BRANCH" \
            --arg msg     "$COMMIT_MSG" \
            --arg sha     "$SHORT_SHA" \
            --arg time    "$TIMESTAMP" \
            --arg compare "$COMPARE" \
            --arg commit  "$COMMIT_URL" \
            '{
              msg_type: "interactive",
              card: {
                config: { wide_screen_mode: true, enable_forward: true },
                header: {
                  template: "green",
                  title: { tag: "plain_text", content: "🚀 新的代码提交" }
                },
                elements: [
                  {
                    tag: "div",
                    fields: [
                      { is_short: true, text: { tag: "lark_md", content: ("**📦 仓库**\n" + $repo) } },
                      { is_short: true, text: { tag: "lark_md", content: ("**🌿 分支**\n`" + $branch + "`") } },
                      { is_short: true, text: { tag: "lark_md", content: ("**👤 提交人**\n" + $actor) } },
                      { is_short: true, text: { tag: "lark_md", content: ("**🔖 版本**\n`" + $sha + "`") } }
                    ]
                  },
                  { tag: "hr" },
                  {
                    tag: "div",
                    text: { tag: "lark_md", content: ("**📝 提交信息**\n" + $msg) }
                  },
                  { tag: "hr" },
                  {
                    tag: "note",
                    elements: [ { tag: "plain_text", content: ("⏰ " + $time) } ]
                  },
                  {
                    tag: "action",
                    actions: [
                      {
                        tag: "button",
                        text: { tag: "plain_text", content: "🔍 查看提交" },
                        type: "primary",
                        url: $commit
                      },
                      {
                        tag: "button",
                        text: { tag: "plain_text", content: "📊 对比变更" },
                        type: "default",
                        url: $compare
                      }
                    ]
                  }
                ]
              }
            }')

          curl -s -X POST "$FEISHU_WEBHOOK_URL" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD"
name: Branch AI Review

# Fires on every push to any branch. Runs the static impact analysis against
# the push diff (before..after), asks MiniMax-M3 to assess blast-radius/risk,
# then posts a Feishu card with the assessment. Runs in parallel with the
# existing Feishu Push Notify workflow (they use the same webhook secret).
#
# Config knobs (Settings → Variables):
#   ENABLE_BRANCH_AI : "false" → skip this workflow          (default: enabled)
#   MINIMAX_MODEL    : model id                              (default: "MiniMax-M3")
#   MINIMAX_BASE_URL : API base                              (default: "https://api.minimaxi.com/anthropic")
#
# Required Secrets:
#   MINIMAX_KEY_BLOB    — obfuscated key (see scripts/lib/keyring.sh)
#   FEISHU_WEBHOOK_URL  — same webhook used by feishu-webhook.yml

on:
  push:
    branches: ["**"]

concurrency:
  group: branch-ai-${{ github.ref }}
  cancel-in-progress: true

jobs:
  analyze:
    if: vars.ENABLE_BRANCH_AI != 'false'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Resolve BASE / HEAD
        id: refs
        run: |
          HEAD_SHA="${{ github.event.after }}"
          BEFORE="${{ github.event.before }}"

          # For a newly-created branch, `before` is 40 zeros. Fall back to the
          # merge-base with the repo default branch so we still get a meaningful diff.
          if [[ "$BEFORE" =~ ^0+$ ]]; then
            DEFAULT_BRANCH="${{ github.event.repository.default_branch }}"
            git fetch origin "$DEFAULT_BRANCH" --depth=100 || true
            BASE_SHA=$(git merge-base "origin/$DEFAULT_BRANCH" "$HEAD_SHA" 2>/dev/null || echo "$HEAD_SHA~1")
          else
            BASE_SHA="$BEFORE"
          fi

          echo "base=$BASE_SHA" >> "$GITHUB_OUTPUT"
          echo "head=$HEAD_SHA" >> "$GITHUB_OUTPUT"
          echo "Analyzing $BASE_SHA..$HEAD_SHA"

      - name: Count changed source files
        id: count
        env:
          BASE_SHA: ${{ steps.refs.outputs.base }}
          HEAD_SHA: ${{ steps.refs.outputs.head }}
        run: |
          COUNT=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA" \
            | grep -E '^src/.*\.(ts|tsx)$' \
            | grep -vE 'src/api/__generated__/|src/solana/|routeTree\.gen\.ts' \
            | wc -l | tr -d ' ')
          echo "count=$COUNT" >> "$GITHUB_OUTPUT"
          echo "Changed source files: $COUNT"

      - name: Install deps (only if we have work to do)
        if: steps.count.outputs.count != '0'
        run: pnpm install --frozen-lockfile

      - name: Install madge
        if: steps.count.outputs.count != '0'
        run: pnpm add -w -D madge

      - name: Run static impact analysis
        if: steps.count.outputs.count != '0'
        env:
          BASE_SHA: ${{ steps.refs.outputs.base }}
          HEAD_SHA: ${{ steps.refs.outputs.head }}
        run: pnpm exec tsx scripts/pr-impact-analysis.ts > impact-report.md

      - name: Build diff summary
        if: steps.count.outputs.count != '0'
        env:
          BASE_SHA: ${{ steps.refs.outputs.base }}
          HEAD_SHA: ${{ steps.refs.outputs.head }}
        run: |
          git diff --stat "$BASE_SHA" "$HEAD_SHA" > diff-stat.txt
          git diff --unified=3 "$BASE_SHA" "$HEAD_SHA" \
            -- 'src/**' ':(exclude)src/api/__generated__/**' ':(exclude)src/solana/**' ':(exclude)src/routeTree.gen.ts' \
            | head -c 120000 > diff-truncated.patch

      - name: Call MiniMax-M3
        if: steps.count.outputs.count != '0'
        id: ai
        env:
          MINIMAX_KEY_BLOB: ${{ secrets.MINIMAX_KEY_BLOB }}
          MINIMAX_MODEL:    ${{ vars.MINIMAX_MODEL || 'MiniMax-M3' }}
          MINIMAX_BASE:     ${{ vars.MINIMAX_BASE_URL || 'https://api.minimaxi.com/anthropic' }}
          COMMIT_MSG:       ${{ github.event.head_commit.message }}
          BRANCH:           ${{ github.ref_name }}
        run: |
          if [ -z "$MINIMAX_KEY_BLOB" ]; then
            echo "assessment=_MINIMAX_KEY_BLOB secret 未设置,跳过 AI 评估_" >> "$GITHUB_OUTPUT"
            echo "ok=0" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          MINIMAX_API_KEY=$(./scripts/lib/keyring.sh decode "$MINIMAX_KEY_BLOB")
          if [ -z "$MINIMAX_API_KEY" ]; then
            echo "assessment=_密钥解码失败_" >> "$GITHUB_OUTPUT"
            echo "ok=0" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          IMPACT=$(cat impact-report.md)
          STAT=$(cat diff-stat.txt)
          DIFF=$(cat diff-truncated.patch)

          cat > /tmp/system-prompt.txt <<'PROMPT_EOF'
          你是一名资深工程师 + 产品经理,正在评审一次分支 push。基于给定的分支信息、静态影响分析报告和 diff,用中文输出精简 Markdown 风险评估,包含 5 段:

          **💼 业务影响** — 从终端用户视角说明:改动波及了哪些业务模块?对应的用户流程可能出现什么变化(如无法进入某页面、操作行为不同、数据展示错误、支付/发放异常)?按业务优先级排序,最多 4 条,每条格式 `- **[模块名]** — 具体影响`。若只改基础设施/工具代码,直接说 "无直接业务影响"。

          **🔥 技术影响范围** — 波及的技术表面(路由、共享模块、hooks、stores 等)。

          **⚠️ 回归风险** — 可能坏的具体场景,按严重度排序,最多 4 条。

          **🧪 测试盲区** — 引用具体文件。

          **✅ 自查清单** — 3-5 条 push 前该验证的项目。

          要求:控制在 800 字以内,飞书卡片渲染友好,引用文件路径和函数名。

          # 业务模块清单(供业务影响判断参考)
          - **创作(create)** — src/features/create, create-short-video
          - **创作管理(creation-management)** — src/features/creation-management
          - **演员(actor)** / **旁白(narrator)** / **剧集(drama-flow)** — src/features/actor, narrator, drama-flow
          - **观看(play)** — src/features/play
          - **首页/仪表盘** — src/features/home, dashboard
          - **收益(income)** / **邀请(invite)** — src/features/income, invite
          - **UGC** — src/features/ugc
          - **游戏/1011** / **挖矿(mining)** — src/features/game, 1011, mining
          - **通知(notification)** — src/features/notification
          - **个人资料(profile)** / **社交(social)** — src/features/profile, social
          - **搜索(search)** / **勋章(badge)** — src/features/search, badge
          - **法务** — src/features/legal
          - **API 层** — src/api(所有业务接口)
          - **Solana 链上** — src/solana(钱包/代币/链上)
          - **鉴权** — @privy-io/react-auth, src/providers
          PROMPT_EOF
          SYSTEM=$(sed 's/^          //' /tmp/system-prompt.txt)

          USER=$(jq -n \
            --arg branch "$BRANCH" \
            --arg msg    "$COMMIT_MSG" \
            --arg impact "$IMPACT" \
            --arg stat   "$STAT" \
            --arg diff   "$DIFF" \
            '"# 分支\n\($branch)\n\n# 最近提交信息\n\($msg)\n\n# 静态影响报告\n\($impact)\n\n# Diff Stat\n```\n\($stat)\n```\n\n# 截断 Diff\n```diff\n\($diff)\n```"')

          PAYLOAD=$(jq -n \
            --arg model "$MINIMAX_MODEL" \
            --arg system "$SYSTEM" \
            --argjson user "$USER" \
            '{
              model: $model,
              system: $system,
              max_tokens: 2000,
              messages: [ { role: "user", content: $user } ]
            }')

          RESPONSE=$(curl -sS --fail-with-body \
            -X POST "$MINIMAX_BASE/v1/messages" \
            -H "x-api-key: $MINIMAX_API_KEY" \
            -H "anthropic-version: 2023-06-01" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD") || {
              CLEANED=$(echo "$RESPONSE" | sed "s|$MINIMAX_API_KEY|***|g" | head -c 500)
              {
                echo "assessment<<EOF_ASSESSMENT"
                echo "_MiniMax 调用失败:_"
                echo "\`\`\`"
                echo "$CLEANED"
                echo "\`\`\`"
                echo "EOF_ASSESSMENT"
                echo "ok=0"
              } >> "$GITHUB_OUTPUT"
              exit 0
            }

          CONTENT=$(echo "$RESPONSE" | jq -r '(.content // []) | map(select(.type=="text") | .text) | join("\n")')
          if [ -z "$CONTENT" ]; then CONTENT="_无法解析 MiniMax 响应_"; fi

          {
            echo "assessment<<EOF_ASSESSMENT"
            echo "$CONTENT"
            echo "EOF_ASSESSMENT"
            echo "ok=1"
          } >> "$GITHUB_OUTPUT"

      - name: Notify Feishu
        if: always()
        env:
          FEISHU_WEBHOOK_URL: ${{ secrets.FEISHU_WEBHOOK_URL }}
          REPO:       ${{ github.repository }}
          BRANCH:     ${{ github.ref_name }}
          ACTOR:      ${{ github.actor }}
          COMMIT_MSG: ${{ github.event.head_commit.message }}
          COMMIT_ID:  ${{ github.event.head_commit.id }}
          COMMIT_URL: ${{ github.event.head_commit.url }}
          COMPARE:    ${{ github.event.compare }}
          CHANGED:    ${{ steps.count.outputs.count }}
          ASSESSMENT: ${{ steps.ai.outputs.assessment }}
          MODEL:      ${{ vars.MINIMAX_MODEL || 'MiniMax-M3' }}
        run: |
          if [ -z "$FEISHU_WEBHOOK_URL" ]; then
            echo "FEISHU_WEBHOOK_URL not set; skipping notification"
            exit 0
          fi

          SHORT_SHA="${COMMIT_ID:0:7}"

          if [ "${CHANGED:-0}" = "0" ]; then
            BODY="_本次推送未修改 src/ 下的 TypeScript 源码,已跳过 AI 分析。_"
            TEMPLATE="grey"
            TITLE="🤖 分支变更 AI 分析(跳过)"
          elif [ -z "$ASSESSMENT" ]; then
            BODY="_AI 分析未生成结果,请查看 Actions 日志。_"
            TEMPLATE="orange"
            TITLE="🤖 分支变更 AI 分析(失败)"
          else
            BODY="$ASSESSMENT"
            TEMPLATE="blue"
            TITLE="🤖 分支变更 AI 分析"
          fi

          PAYLOAD=$(jq -n \
            --arg repo    "$REPO" \
            --arg branch  "$BRANCH" \
            --arg actor   "$ACTOR" \
            --arg sha     "$SHORT_SHA" \
            --arg msg     "$COMMIT_MSG" \
            --arg changed "$CHANGED" \
            --arg body    "$BODY" \
            --arg model   "$MODEL" \
            --arg commit  "$COMMIT_URL" \
            --arg compare "$COMPARE" \
            --arg tmpl    "$TEMPLATE" \
            --arg title   "$TITLE" \
            '{
              msg_type: "interactive",
              card: {
                config: { wide_screen_mode: true, enable_forward: true },
                header: {
                  template: $tmpl,
                  title: { tag: "plain_text", content: $title }
                },
                elements: [
                  {
                    tag: "div",
                    fields: [
                      { is_short: true, text: { tag: "lark_md", content: ("**🌿 分支**\n`" + $branch + "`") } },
                      { is_short: true, text: { tag: "lark_md", content: ("**🔖 版本**\n`" + $sha + "`") } },
                      { is_short: true, text: { tag: "lark_md", content: ("**👤 提交人**\n" + $actor) } },
                      { is_short: true, text: { tag: "lark_md", content: ("**📊 源码改动**\n" + $changed + " 文件") } }
                    ]
                  },
                  { tag: "hr" },
                  { tag: "div", text: { tag: "lark_md", content: $body } },
                  { tag: "hr" },
                  { tag: "note", elements: [ { tag: "plain_text", content: ("🧠 " + $model + " · " + $repo) } ] },
                  {
                    tag: "action",
                    actions: [
                      { tag: "button", text: { tag: "plain_text", content: "🔍 查看提交" }, type: "primary",  url: $commit  },
                      { tag: "button", text: { tag: "plain_text", content: "📊 对比变更" }, type: "default", url: $compare }
                    ]
                  }
                ]
              }
            }')

          curl -s -X POST "$FEISHU_WEBHOOK_URL" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD"

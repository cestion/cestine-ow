{
  "name": "web-onestory-www",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "src/i18n.ts",
    "src/polyfills.ts",
    "src/router.tsx"
  ],
  "type": "module",
  "scripts": {
    "dev": "VITE_DEV_PLAIN_HTTP=1 vite dev",
    "dev:http": "VITE_DEV_PLAIN_HTTP=1 vite dev",
    "dev:https": "VITE_DEV_PLAIN_HTTP=0 vite dev",
    "test": "VITE_DEV_PLAIN_HTTP=1 vite dev --mode testenv",
    "production": "VITE_DEV_PLAIN_HTTP=1 vite dev --mode production",
    "build": "tsx scripts/generate-version-json.ts && vite build",
    "build:dev": "tsx scripts/generate-version-json.ts && vite build --mode development",
    "build:test": "tsx scripts/generate-version-json.ts && vite build --mode testenv",
    "build:production": "tsx scripts/generate-version-json.ts && vite build --mode production",
    "preview": "vite preview",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "start:dev": "NODE_ENV=development node .output/server/index.mjs",
    "start:production": "NODE_ENV=production node .output/server/index.mjs",
    "start:srvx": "pnpx srvx --prod -s ../client dist/server/server.js",
    "fmt": "npx biome check --write ./src",
    "ladle": "VITE_LADLE=true ladle serve",
    "ladle:build": "VITE_LADLE=true ladle build",
    "docs:api-mindmap": "tsx scripts/generate-api-mindmap.ts",
    "docs:contract-mindmap": "tsx scripts/generate-contract-mindmap.ts",
    "generate:api": "ORVAL_MODE=development orval",
    "generate:api:test": "ORVAL_MODE=testenv orval",
    "routes:generate": "tsr generate",
    "i18n:extract": "tsx scripts/i18n-auto/extract.ts",
    "i18n:translate": "tsx scripts/i18n-auto/index.ts",
    "i18n": "pnpm run i18n:extract && pnpm run i18n:translate",
    "assets:optimize": "tsx scripts/optimize-images.ts",
    "assets:optimize:videos": "tsx scripts/optimize-videos.ts",
    "prepare": "husky",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "whitebox": "bash -c 'vitest run --coverage --passWithNoTests --reporter=default --reporter=json --outputFile=/tmp/vitest-results.json; code=$?; VITEST_EXIT_CODE=$code tsx scripts/whitebox-report.ts; exit $code'",
    "whitebox:report": "tsx scripts/whitebox-report.ts",
    "typecheck": "bash -c 'tsc --noEmit --pretty false 2>&1 | tee /tmp/onestory-tsc.log | grep -vE \"src/api/__generated__/|src/solana/\" | grep \"error TS\" >&2; ! grep -vE \"src/api/__generated__/|src/solana/\" /tmp/onestory-tsc.log | grep -q \"error TS\"'",
    "generate:solana": "codama run js && tsx scripts/patch-solana-generated.ts"
  },
  "lint-staged": {
    "*.{js,jsx,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "!(*.stories).{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
      "bash -c 'pnpm exec tsc --noEmit'"
    ]
  },
  "dependencies": {
    "@amazing-socrates/telemetry-kit": "^0.3.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/hooks": "^8.3.18",
    "@privy-io/react-auth": "^3.18.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@solana-program/memo": "^0.11.0",
    "@solana-program/system": "^0.12.0",
    "@solana/kit": "^6.8.0",
    "@solana/kit-plugin-rpc": "^0.11.1",
    "@solana/kit-plugin-signer": "^0.10.0",
    "@solana/program-client-core": "^6.4.0",
    "@solana/react-hooks": "^1.4.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/sysvars": "6.8.0",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/react-table": "^8.21.3",
    "@types/lodash-es": "^4.17.12",
    "@use-gesture/react": "^10.3.1",
    "@vidstack/react": "^1.12.13",
    "aos": "^2.3.4",
    "axios": "^1.13.6",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "centrifuge": "^5.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "hls.js": "^1.6.16",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.23",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260311-beta",
    "node-fetch": "^3.3.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^16.5.8",
    "react-intersection-observer": "^10.0.3",
    "react-resizable-panels": "^4.7.6",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "srvx": "^0.11.12",
    "store2": "^2.14.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@codama/nodes-from-anchor": "^1.4.1",
    "@codama/renderers-js": "^2.2.0",
    "@ladle/react": "^5.1.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-cli": "1.166.25",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/aos": "^3.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "codama": "^1.6.0",
    "gifsicle": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "orval": "^8.5.3",
    "shadcn": "^4.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.1",
    "vite-plugin-react-click-to-component": "^4.2.1",
    "vitest": "^5.0.0"
  }
}